# --- required ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
# generate each one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- optional (defaults shown) ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
# lax works for localhost; use "none" (needs HTTPS) when frontend and API are on different sites
COOKIE_SAME_SITE=lax
# set to 1 when running behind a reverse proxy (Nginx, Render, Railway, ...)
# TRUST_PROXY=1
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_REFRESH_MAX=100
RATE_LIMIT_API_MAX=1000

# --- chatbot (Google Gemini) - optional ---
# Create a key at https://aistudio.google.com/apikey . Keep it on the server only, never in the frontend.
# Without it everything else works and only POST /api/chatbot answers 503.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# used automatically when the main model is overloaded (503). Leave empty to disable the fallback.
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# minimal | low | medium | high (low = fast + cheap, good for a support bot)
# GEMINI_THINKING_LEVEL=low
# GEMINI_TIMEOUT_MS=20000
# chatbot requests allowed per user per minute
# RATE_LIMIT_CHATBOT_MAX=15
